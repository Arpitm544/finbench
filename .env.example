# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (defaults to local SQLite, switches to PostgreSQL in docker/production)
DATABASE_URL=sqlite:///./finbench.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finbench
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLES_DIR=./data/samples
REPORTS_DIR=./reports

# AI Benchmark Evaluation
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=mock-key
EVAL_MODEL=gpt-4o-mini
EVAL_TIMEOUT_SECONDS=30
EVAL_MAX_RETRIES=2
